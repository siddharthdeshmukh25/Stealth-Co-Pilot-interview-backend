[TEMPLATE]
# Copy this file to .env and add your own Groq API key locally.
GROQ_API_KEY=

# Bind address. Keep 0.0.0.0 so a phone on the same Wi-Fi can reach the backend.
HOST=0.0.0.0
PORT=8000

# Relative paths are anchored to the backend folder automatically, so every
# launcher (start_backend.bat, desktop app, packaged exe) uses the same file.
DATABASE_URL=sqlite:///./local_copilot.db

# Extra browser origins. Private LAN ranges (192.168.*, 10.*, 172.16-31.*) are
# always allowed through CORS_ORIGIN_REGEX, so a phone needs no entry here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Groq models (both must exist in your account's model list).
ANSWER_MODEL=openai/gpt-oss-120b
RESUME_MODEL=openai/gpt-oss-120b
